# --- Sorgente remota (endpoint PHP su hosting/api/export.php) ---
REMOTE_API_URL=https://cuoredinapoli.net/database/export.php
# Deve coincidere con 'api_key' in config.php sul server
REMOTE_API_KEY=
REMOTE_API_TIMEOUT_SECONDS=15

# --- Storage locale ---
LOCAL_DB_PATH=data/local.db

# --- Sync ---
# Ogni quanti minuti sincronizzare (usato solo da `python -m src.main run`)
SYNC_INTERVAL_MINUTES=60

# --- Ollama (in rete, su un altro PC) ---
OLLAMA_HOST=http://192.168.1.X:11434
# Modello di embedding, usato per calcolare similarita' semantica tra entry
OLLAMA_EMBED_MODEL=bge-m3
# Modello generativo, usato per scrivere il/i tag testuali di ogni entry
OLLAMA_TAG_MODEL=llama3.1
# Numero massimo di tag per entry
MAX_TAGS_PER_ENTRY=3

# --- Grafo ---
GRAPH_OUTPUT_PATH=output/graph.html

# --- Domanda dell'oracolo (sovrapposta al centro di graph.html) ---
# Quante domande generare ad ogni esecuzione (ne verra' mostrata una a caso)
QUESTIONS_COUNT=10

# --- Webserver locale (serve output/ e risponde alle domande via Ollama) ---
SERVE_HOST=0.0.0.0
SERVE_PORT=8000
